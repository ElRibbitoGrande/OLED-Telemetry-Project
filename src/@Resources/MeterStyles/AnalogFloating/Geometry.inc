; Include this file from the dashboard's [Variables] section.
; This geometry belongs only to the Analog_Floating artwork family.

[Variables]

AnalogFloatingVUArtwork=#@#Images\analog\Analog_Floating.png
AnalogFloatingVUNeedleArtwork=#@#Images\analog\Floating_Needle.png

AnalogFloatingVUNativeWidth=1619
AnalogFloatingVUNativeHeight=971
AnalogFloatingVUNeedleNativeWidth=30
AnalogFloatingVUNeedleNativeHeight=300

AnalogFloatingVURenderWidth=(620 * #AF2VUMeterScale#)
AnalogFloatingVURenderHeight=(372 * #AF2VUMeterScale#)
AnalogFloatingVUNeedleRenderWidth=(25 * #AF2VUMeterScale#)
AnalogFloatingVUNeedleRenderHeight=(248 * #AF2VUMeterScale#)

AnalogFloatingVUPivotX=(18 * #AF2VUMeterScale#)
AnalogFloatingVUPivotY=(243 * #AF2VUMeterScale#)
AnalogFloatingVUStartAngle=11.5
AnalogFloatingVUSweepAngle=2.1

; Needle placement relative to the rendered face origin.
AnalogFloatingVUNeedlePositionX=(302 * #AF2VUMeterScale#)
AnalogFloatingVUNeedlePositionY=(174 * #AF2VUMeterScale#)
AnalogFloatingVUShadowDisplacement=(-3 * #AF2VUMeterScale#)
