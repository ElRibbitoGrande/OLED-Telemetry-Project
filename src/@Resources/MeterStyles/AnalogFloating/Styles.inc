; Geometry styles for the Analog_Floating artwork family.
; Layout skins provide Meter, MeasureName, Group, X, and Y.

[AnalogFloatingVUFaceStyle]
ImageName=#AnalogFloatingVUArtwork#
W=#AnalogFloatingVURenderWidth#
H=#AnalogFloatingVURenderHeight#
PreserveAspectRatio=1
AntiAlias=1

DynamicVariables=1

[AnalogFloatingVUNeedleStyle]
ImageName=#AnalogFloatingVUNeedleArtwork#
W=#AnalogFloatingVUNeedleRenderWidth#
H=#AnalogFloatingVUNeedleRenderHeight#
OffsetX=#AnalogFloatingVUPivotX#
OffsetY=#AnalogFloatingVUPivotY#
StartAngle=#AnalogFloatingVUStartAngle#
RotationAngle=#AnalogFloatingVUSweepAngle#
AntiAlias=1
DynamicVariables=1

[AnalogFloatingVUShadowStyle]
ImageName=#AnalogFloatingVUNeedleArtwork#
W=#AnalogFloatingVUNeedleRenderWidth#
H=#AnalogFloatingVUNeedleRenderHeight#
OffsetX=#AnalogFloatingVUPivotX#
OffsetY=#AnalogFloatingVUPivotY#
StartAngle=#AnalogFloatingVUStartAngle#
RotationAngle=#AnalogFloatingVUSweepAngle#
ImageTint=0,0,0,50
AntiAlias=1
DynamicVariables=1
